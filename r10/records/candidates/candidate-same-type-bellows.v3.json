  "design": {
    "intent": "保留v2两个双门腔及反向回复，修改的是组间关系，不加更多门、不收窄所有窗。 Archive role: event_coupled_revision",
    "theme": "前一风箱合口时，后一风箱接气；上一句的高位结尾被下一句接住，然后落向厚低口收束。",
    "layout": "{\"world_width_px\": 1690.5, \"world_height_px\": 540, \"player_radius_px\": 10, \"obstacles\": [{\"id\": \"Q-in\", \"mechanic_kind\": \"timed_armor_gate\", \"x\": 420, \"y\": 375, \"collider\": {\"shape\": \"rectangle\", \"w\": 72, \"h\": 540}, \"motion\": {\"opening_px\": 180}, \"timeline\": {\"start_s\": 0.665, \"warning_s\": 0.9, \"opening_s\": 0.45, \"hold_s\": 1.25, \"closing_s\": 0.55, \"cooldown_s\": 12}, \"interaction\": {\"lethal\": true}}, {\"id\": \"Q-out\", \"mechanic_kind\": \"timed_armor_gate\", \"x\": 690, \"y\": 215, \"collider\": {\"shape\": \"rectangle\", \"w\": 72, \"h\": 540}, \"motion\": {\"opening_px\": 160}, \"timeline\": {\"start_s\": 2.365, \"warning_s\": 0.9, \"opening_s\": 0.45, \"hold_s\": 1.45, \"closing_s\": 0.55, \"cooldown_s\": 12}, \"interaction\": {\"lethal\": true}}, {\"id\": \"A-in\", \"mechanic_kind\": \"timed_armor_gate\", \"x\": 970.5, \"y\": 245, \"collider\": {\"shape\": \"rectangle\", \"w\": 96, \"h\": 540}, \"motion\": {\"opening_px\": 180}, \"timeline\": {\"start_s\": 4.265, \"warning_s\": 0.9, \"opening_s\": 0.45, \"hold_s\": 1.55, \"closing_s\": 0.55, \"cooldown_s\": 12}, \"interaction\": {\"lethal\": true}}, {\"id\": \"A-out\", \"mechanic_kind\": \"timed_armor_gate\", \"x\": 1265.5, \"y\": 375, \"collider\": {\"shape\": \"rectangle\", \"w\": 120, \"h\": 540}, \"motion\": {\"opening_px\": 200}, \"timeline\": {\"start_s\": 6.0367, \"warning_s\": 0.9, \"opening_s\": 0.45, \"hold_s\": 2.1, \"closing_s\": 0.55, \"cooldown_s\": 12}, \"interaction\": {\"lethal\": true}}], \"nominal_duration_s\": 10.87}",
    "motion": "[\"从v2推导：Q-out closing_start=5.165000s；旧A-in opening_start=6.295000s。差值Δt=1.130000s，因此第二腔整体Δx=150Δt=169.500000px前移。\", \"第二腔两门的x和start_s同时减对应量；警示、开合速度、hold、门厚、开口高度、中心高度完全不改。\", \"新A-in开始开启与Q-out开始闭合都为5.165s。闭门警示仍然致命，不能趁黄色先穿。\", \"Q-out全开中心带(145,285)，A-in全开中心带(165,325)，交集(165,285)只是可接高位的几何条件，不是可达出口状态。\", \"组间完全离开Q-out到首次接近A-in的x空档由约2.386667s变1.256667s；这是压缩的内容，不是全段倍速。\"]",
    "action_grammar": "低入高出 → 看见下一腔闭门警示 → 高位交接候选 → 高入低出 → 厚门平台收句",
    "readability_cues": "四门仍按两腔分组，空档明显缩短但高度变化保留 / warning门画为实闭合实体；opening/closing画真实分离量 / 交接帧同时展示前门在合、后门在开，不画玩家等待",
    "control_contract": "World-coordinate source, nominal player x=60+150t; add absolute Tentry to one-shot warning_s and gate start_s. Fixed vx150/radius10; no stopping, arrival reset or landed platform. Warning-drop warning is nonlethal; gate warning remains closed/lethal."
  },
  "duration": {
    "authored": {
      "min_s": 6.1,
      "recommended_s": 10.87,
      "max_s": 16,
      "conditions": [
        "作者片段估计，非固定时长档"
      ],
      "operators": [
        "若只留一座双门腔，应同时撤回跨腔交接主张；完整两腔不能按比例快放。",
        "第三腔须接收上一腔的真实出口状态，并承担新回复；关—开事件关系要重新配对，不按等距复制。",
        "一座双门腔是短句；两腔之间的高位交接把它们合成较长句。"
      ]
    },
    "physically_qualified": null
  },
  "parameter_relationships": [
    "从v2推导：Q-out closing_start=5.165000s；旧A-in opening_start=6.295000s。差值Δt=1.130000s，因此第二腔整体Δx=150Δt=169.500000px前移。",
    "第二腔两门的x和start_s同时减对应量；警示、开合速度、hold、门厚、开口高度、中心高度完全不改。",
    "新A-in开始开启与Q-out开始闭合都为5.165s。闭门警示仍然致命，不能趁黄色先穿。",
    "Q-out全开中心带(145,285)，A-in全开中心带(165,325)，交集(165,285)只是可接高位的几何条件，不是可达出口状态。",
    "组间完全离开Q-out到首次接近A-in的x空档由约2.386667s变1.256667s；这是压缩的内容，不是全段倍速。"
  ],
  "difficulty_axes": [
    "跨腔出口竖速能否匹配",
    "门体厚度占用时长",
    "关开事件配对与相位偏差",
    "预告能否在承诺之前看见"
  ],
